{
  "crons": [
    { "path": "/api/trackman-sync", "schedule": "0 8 * * *" },
    { "path": "/api/weekly-reminders", "schedule": "0 15 * * 1" },
    { "path": "/api/whoop-sync", "schedule": "0 */2 * * *" },
    { "path": "/api/coach-task-digest", "schedule": "0 14,15 * * *" },
    { "path": "/api/slot-autoclean", "schedule": "5 * * * *" }
  ],
  "functions": {
    "api/trackman-sync.js": { "maxDuration": 60 },
    "api/weekly-reminders.js": { "maxDuration": 60 },
    "api/whoop-sync.js": { "maxDuration": 300 },
    "api/coach-task-digest.js": { "maxDuration": 60 },
    "api/slot-autoclean.js": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nbp-portal.vercel.app" }],
      "destination": "https://www.thenatural-app.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/whoop/callback",
      "destination": "https://cjilkqzifyhssbsiqgfu.supabase.co/functions/v1/whoop-callback"
    },
    {
      "source": "/api/calendar/:token.ics",
      "destination": "https://cjilkqzifyhssbsiqgfu.supabase.co/functions/v1/calendar-feed?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://cjilkqzifyhssbsiqgfu.supabase.co wss://cjilkqzifyhssbsiqgfu.supabase.co https://api.resend.com https://api.prod.whoop.com; frame-src 'self' https://cjilkqzifyhssbsiqgfu.supabase.co https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://www.loom.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
